pipeline {
    agent {
        docker {
            image 'maven:3.9.9-eclipse-temurin-17'  // Using Maven Docker image
            args '-v /var/jenkins_home:/var/jenkins_home'  // Persist Jenkins home
        }
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm  // Checkout code from Git repository
            }
        }

        stage('Build') {
            steps {
                script {
                    // Running Maven build with clean and package
                    sh 'mvn -B -DskipTests clean package'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    // Run tests (this step is skipped if the build fails)
                    sh 'mvn test'
                }
            }
        }

        stage('Deliver') {
            steps {
                script {
                    // Delivery steps (e.g., Docker image push or deploy)
                    echo "Delivery step is skipped for this example"
                }
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
